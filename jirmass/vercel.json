{
  "version": 2,
  "builds": [
    {
      "src": "api/django.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "static/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "cache-control": "public, max-age=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/(api/products/.*|admin/.*|healthz)",
      "dest": "api/django.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
