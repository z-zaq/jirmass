# ==============================================================================
# Jirmass Plastics - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit the actual .env file with secrets into version control.
# ==============================================================================

# --- Go Frontend Server Settings ---
PORT=8081
BACKEND_URL=http://localhost:8000
ADMIN_WEBHOOK_URL=https://example.com/webhook/alerts
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash

# --- Django Backend Settings ---
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database Settings (Defaults to SQLite if unset) ---
# DATABASE_URL=postgres://user:password@localhost:5432/jirmass_db

# --- Email / SMTP Settings (Optional) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=sales@jirmassplastics.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
