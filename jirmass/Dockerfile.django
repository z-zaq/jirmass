FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/app \
    XDG_RUNTIME_DIR=/tmp

# Install build/runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy Django project files
COPY backend/ ./

# Create staticfiles and media directories
RUN mkdir -p /app/staticfiles /app/media

# Install entrypoint script and ensure it is executable
RUN cp /app/entrypoint.sh /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/entrypoint.sh /app/entrypoint.sh

# Create non-root system user with explicit valid home directory and verify permissions
RUN groupadd --system appgroup && \
    useradd --system --gid appgroup --home-dir /app --no-create-home --shell /bin/bash appuser && \
    mkdir -p /home/appuser /app/staticfiles /app/media && \
    chown -R appuser:appgroup /app /home/appuser && \
    chmod -R 755 /app /home/appuser

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["gunicorn", "--no-control-socket"]


